{
  "id": "spec_shutoff_12col",
  "name": "仪表规格书（气动切断阀）12列单阀版",
  "valve_type": [
    "球阀",
    "切断阀"
  ],
  "detect": {
    "must_any": [
      "项目文件号",
      "气动球阀规格书",
      "IN-00/R572"
    ],
    "score_words": [
      "阀芯结构",
      "Trim Structure",
      "抗气蚀",
      "控讯箱",
      "事故风罐",
      "防杆吹出",
      "隔爆接近式",
      "最低工作电压",
      "阀位变送器",
      "行程开关数量",
      "Sizing Cv",
      "Solenoid"
    ],
    "min_score": 2
  },
  "struct": {
    "ncols": [
      12
    ],
    "valves_per_page": 1,
    "seq_col": 1
  },
  "parse": {
    "parse_mode": "pdf_inline",
    "valves_per_page": 1,
    "col_map": {
      "seq": 1,
      "name": 2,
      "name2": 5,
      "val": 7,
      "val2": 9
    },
    "summary": {
      "header_any": [
        "位号",
        "Tag"
      ],
      "tag_pat": "^[0-9]{3,4}[A-Z]?-[A-Z]{2,4}-[0-9]{2,5}[A-Z]?$",
      "keys": {
        "tag": "位号|tag",
        "service": "用途|service",
        "pipe": "管道号|pipe\\s*no",
        "pid": "流程图|p&id",
        "fluid": "介质|fluid",
        "temp": "操作温度|温度|temp",
        "pressure": "操作压力|压力|press",
        "dp": "关闭压差|差压|dp",
        "remark": "备注|remark"
      }
    },
    "tag_regex": "(?<![A-Za-z0-9])[0-9]{3,4}[A-Z]?-[A-Z]{2,4}-[0-9]{2,5}[A-Z]?(?![A-Za-z0-9])",
    "overrides": [
      {
        "seq": 1,
        "col": 7
      },
      {
        "seq": 2,
        "col": 9,
        "sub": true
      },
      {
        "seq": 9,
        "col": 7
      },
      {
        "seq": 10,
        "col": 7
      }
    ],
    "footnote": {
      "original_title": "备注原文",
      "translated_title": "翻译备注",
      "after": "Q",
      "translate": true,
      "min_len": 8,
      "below_table": true
    }
  },
  "fields": [
    {
      "meta": "tag",
      "to": "B",
      "label": "位号"
    },
    {
      "meta": "service",
      "to": "G",
      "label": "用途"
    },
    {
      "meta": "fluid",
      "to": "H",
      "label": "介质"
    },
    {
      "meta": "pid",
